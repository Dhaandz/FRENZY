<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trading Journal Dhandz</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#10131a;color:#eee}
.wrap{max-width:1050px;margin:auto;padding:18px}.card{background:#191e28;border:1px solid #2b3340;border-radius:14px;padding:16px;margin-bottom:14px}
h1,h2{margin:0 0 12px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
label{font-size:12px;color:#aab3c2;display:block;margin-bottom:5px}
input,select,textarea,button{width:100%;border:1px solid #343d4d;border-radius:9px;padding:10px;background:#11151d;color:#fff}
textarea{min-height:70px;resize:vertical}button{cursor:pointer;font-weight:700;background:#263246}
button.primary{background:#1976d2}button.danger{background:#8b3030}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.actions button{width:auto}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.stat{background:#11151d;border-radius:10px;padding:12px}.stat b{display:block;font-size:20px;margin-top:4px}
.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:850px}th,td{padding:9px;border-bottom:1px solid #2b3340;text-align:left;font-size:13px}th{color:#aab3c2}
.win{color:#39d98a}.loss{color:#ff6b6b}.muted{color:#aab3c2}.small{font-size:12px}
@media(max-width:750px){.grid{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}}
.profile{display:flex;align-items:center;gap:16px;margin-top:14px;padding:14px;background:#11151d;border:1px solid #2b3340;border-radius:12px}.profile img{width:82px;height:82px;border-radius:50%;object-fit:cover;border:3px solid #343d4d}.profile h2{margin:0 0 6px;font-size:22px}.contacts{display:flex;gap:8px;flex-wrap:wrap}.contact{display:inline-block;width:auto!important;text-decoration:none;color:#fff!important;padding:8px 11px!important;border-radius:8px!important;background:#263246!important;border:1px solid #343d4d!important;font-size:13px}@media(max-width:600px){.profile{align-items:flex-start}.profile img{width:70px;height:70px}}</style>
</head>
<body>
<div class="wrap">
<div class="card">
<h1>📊 Trading Journal — Dhandz</h1>
<div class="muted">Catat trade, hitung PNL dalam Rupiah (Rp) & RR, dan lihat statistik secara otomatis. Data tersimpan di browser perangkat ini.</div><div class="profile"><img src="data:image/png;base64," alt="Foto profil Dhandz"><div><h2>Dhandz</h2><div class="muted small">Trading Journal • PNL Rupiah</div><div class="contacts" style="margin-top:9px"><a class="contact" href="mailto:dhandyramadhan22@gmail.com">📧 Email</a><a class="contact" href="https://wa.me/6281549252711" target="_blank" rel="noopener">📱 WhatsApp</a><a class="contact" href="https://instagram.com/15.dhandz" target="_blank" rel="noopener">📸 Instagram</a></div></div></div>
</div>

<div class="card">
<h2>Input Trade</h2>
<div class="grid">
<div><label>Tanggal</label><input id="date" type="datetime-local"></div>
<div><label>Pair / Saham</label><input id="symbol" placeholder="BTC/USDT"></div>
<div><label>Posisi</label><select id="side"><option>LONG</option><option>SHORT</option></select></div>
<div><label>Modal akun (Rp)</label><input id="balance" type="number" step="1000" value="10000000"></div>
<div><label>Kurs USD/USDT → Rp</label><input id="rate" type="number" step="1" value="16500"></div>
<div><label>Entry</label><input id="entry" type="number" step="any"></div>
<div><label>Exit</label><input id="exit" type="number" step="any"></div>
<div><label>Stop Loss</label><input id="sl" type="number" step="any"></div>
<div><label>Take Profit</label><input id="tp" type="number" step="any"></div>
<div><label>Position Size (Rp)</label><input id="size" type="number" step="1000" value="1000000"></div>
<div><label>Leverage</label><input id="lev" type="number" step="0.1" value="1"></div>
<div><label>Fee (%)</label><input id="fee" type="number" step="0.001" value="0.1"></div>
<div><label>Setup</label><input id="setup" placeholder="Breakout / Pullback"></div>
</div>
<div style="margin-top:10px"><label>Catatan / alasan entry</label><textarea id="notes" placeholder="Kenapa entry? Kondisi market?"></textarea></div>
<div class="actions">
<button class="primary" onclick="addTrade()">➕ Simpan Trade</button>
<button onclick="clearForm()">Reset</button>
<button class="danger" onclick="clearAll()">Hapus Semua Data</button>
</div>
</div>

<div class="card">
<h2>Dashboard</h2>
<div class="stats">
<div class="stat">Trades<b id="trades">0</b></div>
<div class="stat">Win Rate<b id="winrate">0%</b></div>
<div class="stat">Net P/L<b id="net">Rp0</b></div>
<div class="stat">Profit Factor<b id="pf">0.00</b></div>
<div class="stat">Max Drawdown<b id="dd">Rp0</b></div>
</div>
</div>

<div class="card">
<h2>Riwayat Trade</h2>
<div class="table-wrap">
<table><thead><tr>
<th>Tanggal</th><th>Pair</th><th>Side</th><th>Entry</th><th>Exit</th><th>P/L</th><th>RR</th><th>Hasil</th><th>Aksi</th>
</tr></thead><tbody id="tbody"></tbody></table>
</div>
</div>
</div>

<script>
let trades=JSON.parse(localStorage.getItem("tradingJournal")||"[]");
const $=id=>document.getElementById(id);
function nowLocal(){
 const d=new Date(), off=d.getTimezoneOffset(); return new Date(d-off*60000).toISOString().slice(0,16);
}
$("date").value=nowLocal();

function calc(){
 const side=$("side").value, e=+$("entry").value, x=+$("exit").value, sl=+$("sl").value, tp=+$("tp").value;
 const size=+$("size").value||0, fee=(+$("fee").value||0)/100;
 if(!e||!x||!size)return null;
 const move=side==="LONG"?(x-e)/e:(e-x)/e;
 const gross=size*move, fees=size*fee*2, pnl=gross-fees;
 let risk=Math.abs(e-sl)/e, reward=Math.abs(tp-e)/e;
 const rr=risk>0?reward/risk:0;
 return {pnl,rr};
}
function addTrade(){
 const c=calc();
 if(!c){alert("Isi minimal Entry, Exit, dan Position Size.");return}
 const t={
  id:Date.now(),date:$("date").value,symbol:$("symbol").value||"-",side:$("side").value,
  entry:+$("entry").value,exit:+$("exit").value,sl:+$("sl").value,tp:+$("tp").value,
  size:+$("size").value,lev:+$("lev").value,fee:+$("fee").value,balance:+$("balance").value,rate:+$("rate").value,setup:$("setup").value,notes:$("notes").value,
  pnl:c.pnl,rr:c.rr
 };
 trades.unshift(t);save();clearForm();
}
function save(){localStorage.setItem("tradingJournal",JSON.stringify(trades));render()}
function clearForm(){
 ["symbol","entry","exit","sl","tp","setup","notes"].forEach(id=>$(id).value="");
 $("date").value=nowLocal();$("side").value="LONG";$("balance").value=10000000;$("rate").value=16500;$("size").value=1000000;$("lev").value=1;$("fee").value=.1;
}
function del(id){trades=trades.filter(t=>t.id!==id);save()}
function clearAll(){if(confirm("Hapus semua riwayat trade?")){trades=[];save()}}
function money(n){
 const sign=n<0?"-":"";
 return sign+"Rp"+Math.abs(n).toLocaleString("id-ID",{minimumFractionDigits:0,maximumFractionDigits:0});
}
function render(){
 const tb=$("tbody");tb.innerHTML="";
 trades.forEach(t=>{
  const tr=document.createElement("tr");
  const cls=t.pnl>=0?"win":"loss";
  tr.innerHTML=`<td>${t.date.replace("T"," ")}</td><td>${esc(t.symbol)}</td><td>${t.side}</td>
  <td>${t.entry}</td><td>${t.exit}</td><td class="${cls}">${money(t.pnl)}</td>
  <td>1:${t.rr.toFixed(2)}</td><td class="${cls}">${t.pnl>=0?"WIN":"LOSS"}</td>
  <td><button onclick="del(${t.id})">Hapus</button></td>`;
  tb.appendChild(tr);
 });
 const n=trades.length,w=trades.filter(t=>t.pnl>0).length;
 const net=trades.reduce((a,t)=>a+t.pnl,0), gp=trades.filter(t=>t.pnl>0).reduce((a,t)=>a+t.pnl,0), gl=Math.abs(trades.filter(t=>t.pnl<0).reduce((a,t)=>a+t.pnl,0));
 let peak=0,eq=0,maxdd=0;
 trades.slice().reverse().forEach(t=>{eq+=t.pnl;peak=Math.max(peak,eq);maxdd=Math.max(maxdd,peak-eq)});
 $("trades").textContent=n;$("winrate").textContent=n?(w/n*100).toFixed(1)+"%":"0%";
 $("net").textContent=money(net);$("net").className=net>=0?"win":"loss";$("pf").textContent=gl? (gp/gl).toFixed(2):gp?"∞":"0.00";$("dd").textContent=money(-maxdd);
}
function esc(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
render();
</script>
</body>
</html>
